--!strict
local Lifecycle = require("../../project_template/src/shared/GameLifecycle")
local scope = Lifecycle.new()
local log = {}
assert(scope:start(function()
	scope:track(function() table.insert(log, "first") end)
	scope:track(function() table.insert(log, "second"); error("cleanup failure") end)
	scope:track(function() table.insert(log, "third") end)
end))
local token = scope.generation
assert(scope:isCurrent(token))
assert(not scope:start(function() error("must not start twice") end))
local stopped, errors = scope:stop()
assert(stopped and #errors == 1)
assert(table.concat(log, ",") == "third,second,first")
assert(not scope:isCurrent(token))
assert(not scope:stop())
scope:track(function() table.insert(log, "late") end)
assert(log[4] == "late")
local ok = pcall(function()
	scope:start(function()
		scope:track(function() table.insert(log, "rollback") end)
		error("startup failure")
	end)
end)
assert(not ok and not scope.active and log[5] == "rollback")
assert(scope:start() and not scope:isCurrent(token))
scope:stop()
print("PASS lifecycle: idempotence, reverse cleanup, error isolation, rollback, generations")
